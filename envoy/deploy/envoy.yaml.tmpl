# Envoy in front of the backend, tuned the way a careful team would:
#
#   - per-tenant local rate limits (no tenant above TENANT_RPS), with
#     Retry-After on the 429 so clients know when to come back
#   - adaptive concurrency: learn the backend's latency and cap requests
#     in flight to what keeps it near its best. While it re-measures the
#     best-case latency it holds the limit at min_concurrency, so that is
#     set to the concurrency normal traffic needs (8), not below it.
#   - admission control: reject early when the backend's success rate
#     drops. Adaptive concurrency refuses with 429, which admission control
#     counts as a success, so it judges only the backend's own answers.
#   - circuit breakers with a pending queue, and a retry budget so Envoy's
#     own retries can't snowball
#   - Envoy retries a 503 or a reset twice, with backoff
#   - least-request load balancing across the backend machines, with an
#     active health check every 2 s, so a machine that comes online takes
#     traffic within seconds and one that stops answering is dropped
#
# run.sh fills in the backend machines, the global rate ceiling and one
# rate-limit descriptor per tenant.
admin:
  address:
    socket_address: { address: "::", port_value: 9901, ipv4_compat: true }

static_resources:
  listeners:
    - name: ingress
      address:
        socket_address: { address: "::", port_value: 8080, ipv4_compat: true }
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: ingress
                route_config:
                  name: backend
                  virtual_hosts:
                    - name: backend
                      domains: ["*"]
                      routes:
                        - match: { prefix: "/" }
                          route:
                            cluster: backend
                            timeout: 10s
                            retry_policy:
                              retry_on: "connect-failure,reset,retriable-status-codes"
                              retriable_status_codes: [503]
                              num_retries: 2
                              retry_back_off: { base_interval: 0.05s, max_interval: 0.5s }
                            rate_limits:
                              - actions:
                                  - request_headers: { header_name: x-tenant, descriptor_key: tenant }
                          typed_per_filter_config:
                            envoy.filters.http.local_ratelimit:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.local_ratelimit.v3.LocalRateLimit
                              stat_prefix: tenant_rate_limit
                              token_bucket: { max_tokens: __GLOBAL_RPS__, tokens_per_fill: __GLOBAL_RPS__, fill_interval: 1s }
                              filter_enabled:
                                runtime_key: tenant_rate_limit_enabled
                                default_value: { numerator: 100, denominator: HUNDRED }
                              filter_enforced:
                                runtime_key: tenant_rate_limit_enforced
                                default_value: { numerator: 100, denominator: HUNDRED }
                              response_headers_to_add:
                                - append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                  header: { key: retry-after, value: "1" }
                              descriptors:
__DESCRIPTORS__
                http_filters:
                  - name: envoy.filters.http.local_ratelimit
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.local_ratelimit.v3.LocalRateLimit
                      stat_prefix: tenant_rate_limit
                  - name: envoy.filters.http.adaptive_concurrency
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.adaptive_concurrency.v3.AdaptiveConcurrency
                      gradient_controller_config:
                        sample_aggregate_percentile: { value: 90 }
                        concurrency_limit_params:
                          max_concurrency_limit: 64
                          concurrency_update_interval: 0.1s
                        min_rtt_calc_params:
                          interval: 60s
                          request_count: 50
                          jitter: { value: 10 }
                          buffer: { value: 25 }
                          min_concurrency: 8
                      enabled: { default_value: true, runtime_key: adaptive_concurrency.enabled }
                      # 429, not the default 503, so admission control below
                      # doesn't count these refusals as backend failures.
                      concurrency_limit_exceeded_status: { code: 429 }
                  - name: envoy.filters.http.admission_control
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.admission_control.v3.AdmissionControl
                      enabled: { default_value: true, runtime_key: admission_control.enabled }
                      sampling_window: 30s
                      aggression: { default_value: 1.5, runtime_key: admission_control.aggression }
                      sr_threshold: { default_value: { value: 95.0 }, runtime_key: admission_control.sr_threshold }
                      rps_threshold: { default_value: 5, runtime_key: admission_control.rps_threshold }
                      max_rejection_probability: { default_value: { value: 80.0 }, runtime_key: admission_control.max_rejection_probability }
                      success_criteria:
                        http_criteria:
                          http_success_status: [{ start: 100, end: 500 }]
                  - name: envoy.filters.http.router
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router

  clusters:
    - name: backend
      type: STRICT_DNS
      dns_lookup_family: V6_ONLY
      connect_timeout: 1s
      lb_policy: LEAST_REQUEST
      health_checks:
        - timeout: 1s
          interval: 2s
          unhealthy_threshold: 2
          healthy_threshold: 1
          no_traffic_interval: 2s
          http_health_check: { path: /health }
      circuit_breakers:
        thresholds:
          - priority: DEFAULT
            max_connections: 256
            max_pending_requests: 64
            max_requests: 64
            retry_budget:
              budget_percent: { value: 20.0 }
              min_retry_concurrency: 3
      load_assignment:
        cluster_name: backend
        endpoints:
          - lb_endpoints:
__ENDPOINTS__
